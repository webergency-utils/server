{
  "name": "@webergency-utils/server",
  "version": "0.1.7",
  "description": "Industrial-grade Zero-Reflection AOT web server engine",
  "type": "module",
  "author": "radixxko",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "webergency-server-build": "./dist/compiler/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./transformer": "./dist/compiler/transformer.js"
  },
  "files": [
    "dist",
    "USAGE.md",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf ./dist/* node_modules package-lock.json && npm i",
    "commit": "node -e \"const version = require('./package.json').version.trim(); require('child_process').execSync('git add . && git commit -m \\\"Version ' + version + '\\\"');\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node update_imports.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "version": "npm run build && npm publish --access public && npm run commit && git push",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webergency-utils/server.git"
  },
  "bugs": {
    "url": "https://github.com/webergency-utils/server/issues"
  },
  "homepage": "https://github.com/webergency-utils/server#readme",
  "dependencies": {
    "@webergency-utils/typechecker": "^0.1.3"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.9.1",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.1",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3 || ^7.0.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.6"
  }
}
