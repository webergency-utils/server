{
  "name": "@webergency-utils/server",
  "version": "0.8.0",
  "description": "Industrial-grade Zero-Reflection AOT web server engine",
  "license": "MIT",
  "type": "module",
  "author": "radixxko",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "webergency-tsc": "./dist/compiler/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./transformer": {
      "import": {
        "types": "./dist/compiler/transformer.d.ts",
        "default": "./dist/compiler/transformer.js"
      },
      "require": {
        "types": "./dist/compiler/transformer.d.cts",
        "default": "./dist/compiler/transformer.cjs"
      }
    },
    "./register": {
      "import": {
        "types": "./dist/compiler/register.d.ts",
        "default": "./dist/compiler/register.js"
      },
      "require": {
        "types": "./dist/compiler/register.d.cts",
        "default": "./dist/compiler/register.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "bench": "tsx bench/index.ts",
    "test:runtime": "node scripts/runtime-suite.mjs",
    "test:runtime:smoke": "node scripts/runtime-smoke.mjs",
    "test:bun": "bun --bun ./node_modules/vitest/vitest.mjs run && bun scripts/runtime-suite.mjs",
    "test:deno": "deno run --allow-net --allow-env --allow-read --node-modules-dir=manual --min-dep-age=0 scripts/runtime-suite.mjs",
    "fuzz": "npm run build:fuzz && jazzer fuzz/server.cjs",
    "coverage": "vitest run --coverage",
    "coverage:bun": "bun --bun ./node_modules/vitest/vitest.mjs run --coverage --coverage.provider=istanbul",
    "coverage:runtime:node": "c8 --reporter=lcov --reporter=json --report-dir=coverage/runtime-node --include=dist/index.js node scripts/runtime-suite.mjs",
    "coverage:runtime:deno": "mkdir -p coverage/runtime-deno && rm -rf coverage/deno-profile && deno run --allow-net --allow-env --allow-read --allow-write --node-modules-dir=manual --min-dep-age=0 --coverage=coverage/deno-profile scripts/runtime-suite.mjs && deno coverage coverage/deno-profile --lcov --output=coverage/runtime-deno/lcov.info && node scripts/filter-lcov.mjs coverage/runtime-deno/lcov.info src/adapters/deno-adapter.ts",
    "clean": "rm -rf ./dist ./dist-fuzz",
    "reset": "npm run clean && rm -rf node_modules package-lock.json && npm i",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsx src/compiler/cli.ts -p tsconfig.build.json",
    "build:cjs": "tsup",
    "build:fuzz": "esbuild fuzz/runtime.ts --bundle --platform=node --format=cjs --outfile=dist-fuzz/runtime.cjs",
    "prepublishOnly": "npm run build",
    "commit": "node --input-type=module -e \"import { readFileSync } from 'node:fs'; import { execSync } from 'node:child_process'; const version = JSON.parse(readFileSync('./package.json', 'utf8')).version.trim(); execSync('git add . && git commit -m ' + JSON.stringify('Version ' + version), { stdio: 'inherit' });\"",
    "version": "npm run build && npm publish --access public && npm run commit && git push"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webergency-utils/server.git"
  },
  "bugs": {
    "url": "https://github.com/webergency-utils/server/issues"
  },
  "homepage": "https://github.com/webergency-utils/server#readme",
  "dependencies": {
    "@webergency-utils/typechecker": "^0.7.0"
  },
  "peerDependencies": {
    "typescript": "^5 || ^6"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "minimatch@9": {
      "brace-expansion": "2.1.4"
    },
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jazzer.js/core": "^4.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.1",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.6",
    "c8": "^12.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "tinybench": "^6.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.6"
  }
}
